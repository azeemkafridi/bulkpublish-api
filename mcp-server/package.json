{
  "name": "@bulkpublish/mcp-server",
  "version": "1.1.2",
  "description": "Model Context Protocol server for BulkPublish — lets AI assistants manage social media posts, channels, media, and analytics.",
  "mcpName": "io.github.azeemkafridi/bulkpublish",
  "repository": {
    "type": "git",
    "url": "https://github.com/azeemkafridi/bulkpublish-api.git",
    "directory": "mcp-server"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bulkpublish-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "npm run build:ui && tsc",
    "build:ui": "node scripts/build-ui.mjs && node scripts/embed-ui.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "bulkpublish",
    "social-media",
    "ai",
    "claude",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
